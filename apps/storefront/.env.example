# Where the API runs (server-side only). The storefront forwards the shopper's Host header, so the API resolves the
# same store: open http://demo.localhost:3002 while the API is on :3000.
API_URL=http://localhost:3000
# Platform base domain: stores live at <slug>.<PLATFORM_BASE_DOMAIN> or on their own custom domain. Dev: localhost.
PLATFORM_BASE_DOMAIN=localhost
# Hostnames next/image may optimise images from (comma separated). Add your media/CDN host in production.
IMAGE_HOSTS=localhost,127.0.0.1
