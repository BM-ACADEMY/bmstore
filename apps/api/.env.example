# --- Runtime ---
NODE_ENV=development
PORT=3000
# Dev: storename.localhost  |  Prod: storename.bmstore.in
ROOT_DOMAIN=localhost
# Set to 1 only when behind a trusted reverse proxy (so req.hostname uses X-Forwarded-Host)
TRUST_PROXY=0

# --- Data stores ---
# Two roles, same database. Row-level security applies to the application role and never to the owner.
#  - DATABASE_URL       application role (created by `npm run db:app-role`, which sets THIS password on it)
#  - DATABASE_ADMIN_URL owner role: `prisma migrate`, the audited superadmin bypass, tenant resolution
DATABASE_URL=postgresql://bmstore_app:change-me-app-role-password@localhost:5432/bmstore?schema=public
DATABASE_ADMIN_URL=postgresql://bmstore:bmstore@localhost:5432/bmstore?schema=public
REDIS_URL=redis://localhost:6379
TENANT_CACHE_TTL_SECONDS=300

# --- Auth (generate with: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=30

# --- Login protection (defaults shown; Redis-backed per-IP limits fail OPEN if Redis is down, account locks live in Postgres) ---
LOGIN_IP_LIMIT=20
LOGIN_IP_WINDOW_SECONDS=60
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_BASE_SECONDS=60
LOGIN_LOCK_MAX_SECONDS=3600
PASSWORD_RESET_TTL_MINUTES=30
# {host} = the Host the request came in on, {token} = the raw single-use token
PASSWORD_RESET_URL_TEMPLATE=https://{host}/reset-password?token={token}
FORGOT_PER_EMAIL_LIMIT=3
FORGOT_PER_IP_LIMIT=10
FORGOT_WINDOW_SECONDS=900

# --- Uploads: the browser PUTs files straight to S3 (or R2/MinIO) with a presigned URL from POST /store/uploads/presign.
# Leave S3_BUCKET empty to disable uploads (the endpoint answers 503). Never a multipart parser in the API.
# Local (docker compose up -d): RustFS (S3-compatible). Production: Cloudflare R2 (S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com,
# S3_FORCE_PATH_STYLE=0, S3_PUBLIC_BASE_URL=your public bucket domain) or AWS S3 (no S3_ENDPOINT).
S3_BUCKET=bmstore
S3_REGION=ap-south-1
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=1
S3_ACCESS_KEY_ID=bmstore
S3_SECRET_ACCESS_KEY=bmstore-minio
# Where browsers load images from (defaults to <endpoint>/<bucket>, which is right for MinIO)
S3_PUBLIC_BASE_URL=
# per image, bytes (phone photos are 3-8 MB)
UPLOAD_MAX_BYTES=12582912
UPLOAD_URL_TTL_SECONDS=300
# WebP conversion runs inside the API process; set 0 to run it in a separate process (node dist/main.js with MEDIA_WORKER=1 there)
MEDIA_WORKER=1
MEDIA_WORKER_INTERVAL_MS=3000

# --- Encryption of Razorpay keys (AES-256-GCM). 32 random bytes, base64. ---
# generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Bootstrap superadmin (used by `npm run seed:superadmin`) ---
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# --- Storefront / checkout (Phase 3) ---
# Public base domain of the platform: stores are <slug>.<domain>; client domains CNAME to it. In production ROOT_DOMAIN defaults to it.
PLATFORM_BASE_DOMAIN=store.bmtechx.in
# Rate limits (Redis, fail open): checkout attempts per IP, OTP sends per phone / per IP, order lookups per IP, per window (seconds)
CHECKOUT_IP_LIMIT=10
CHECKOUT_WINDOW_SECONDS=600
OTP_PHONE_LIMIT=5
OTP_IP_LIMIT=20
OTP_WINDOW_SECONDS=600
OTP_TTL_SECONDS=300
LOOKUP_IP_LIMIT=20
LOOKUP_WINDOW_SECONDS=600
# Razorpay REST base. Keys are per store (encrypted in tenants); tests and local dev may point this at test/razorpay-fake.ts
RAZORPAY_API_BASE=https://api.razorpay.com
# Background jobs inside the API process: unpaid-order expiry every minute, weekly owner summary (Mon 09:00 IST)
JOBS_ENABLED=1
JOBS_INTERVAL_MS=60000

# --- Phase 5: developer console, QA, jobs, webhooks ---
# Public store URL / store admin URL ({host} = <subdomain>.<ROOT_DOMAIN>). Dev defaults: storefront :3002, admin :3001.
STORE_URL_TEMPLATE=
ADMIN_URL_TEMPLATE=
# BullMQ scheduled jobs + webhook delivery worker inside the API process (default 1; 0 under test)
JOBS_WORKER=1
# One n8n webhook receives every event (store.created, intake.completed, qa.result, store.live, renewal.due)
N8N_WEBHOOK_URL=
# HMAC-SHA256 key for X-BMStore-Signature (generate with: openssl rand -hex 32)
WEBHOOK_SECRET=
# Platform Razorpay account (client setup fees) for the refund helper. Test keys only unless RAZORPAY_ALLOW_LIVE_REFUNDS=1.
PLATFORM_RAZORPAY_KEY_ID=
PLATFORM_RAZORPAY_KEY_SECRET=
RAZORPAY_ALLOW_LIVE_REFUNDS=0
# Seller details printed on credit notes
PLATFORM_LEGAL_NAME=BM Techx
PLATFORM_GSTIN=
PLATFORM_ADDRESS=
# Developer alerts (stub transport until a WhatsApp/email provider is wired)
DEVELOPER_WHATSAPP=919403892971
DEVELOPER_EMAIL=
# infra/backup state directory (backup.nightly.last) read by the nightly backup check
BMSTORE_STATE_DIR=/state
# Public holidays skipped when counting working days (YYYY-MM-DD, comma separated)
WORKING_DAY_HOLIDAYS=
